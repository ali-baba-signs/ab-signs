# BETTER_AUTH_SECRET="generate-a-32-byte-random-secret"
# BETTER_AUTH_URL="https://your-domain.com"
# NEXT_PUBLIC_SITE_URL="https://alibabasigns.com.au"
# ADMIN_AUTH_SECRET="generate-a-different-32-byte-random-secret"
# NEXT_PUBLIC_ADMIN_ENTRY_PATH="staff-portal"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# # Optional if you later use Neon Auth/Stack Auth JWT validation directly.
# NEON_AUTH_URL=""
# NEON_JWKS_URL=""

# # Cloudflare Images or R2 uploads.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_R2_BUCKET=""
# CLOUDFLARE_R2_ACCESS_KEY_ID=""
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
# CLOUDFLARE_IMAGES_ACCOUNT_HASH=""
# CLOUDFLARE_IMAGES_DELIVERY_URL=""
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL="https://pub-...."
# NEXT_PUBLIC_R2_ASSETS_ENABLED="false"

# # Payments. Use Stripe test keys and the webhook signing secret from the
# # Stripe CLI or a test-mode Workbench webhook endpoint during verification.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
# PAYPAL_ENVIRONMENT="sandbox"

# # Contact form email. Set every value explicitly for your mail provider;
# # do not expose these variables with a NEXT_PUBLIC_ prefix.
# SMTP_HOST="mail.alibabasigns.com.au"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-mailbox@alibabasigns.com.au"
# SMTP_PASSWORD=""
# SMTP_FROM_EMAIL="your-mailbox@alibabasigns.com.au"
# SMTP_FROM_NAME="Ali Baba Signs"
# CONTACT_TO_EMAIL="contact@alibabasigns.com.au"
# CONTACT_FALLBACK_EMAIL="contact@alibabasigns.com.au"
# SMTP_REQUIRE_TLS="true"
# SMTP_CONNECTION_TIMEOUT_MS="10000"
# SMTP_GREETING_TIMEOUT_MS="10000"
# SMTP_SOCKET_TIMEOUT_MS="20000"
# SMTP_SEND_ACKNOWLEDGEMENT="false"
# CONTACT_RATE_LIMIT_SALT="generate-a-random-server-only-value"
